# Supabase (https://app.supabase.com → 프로젝트 설정 → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT (직접 생성: openssl rand -base64 64)
JWT_SECRET=your_jwt_secret_min_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# AES-256 암호화 키
ENCRYPTION_KEY=your_32_byte_encryption_key_here

# Firebase Admin SDK (FCM 푸시)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# 네이버맵 (https://console.ncloud.com → AI·NAVER API → Application)
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=your_naver_client_id

# 토스페이먼츠 (https://developers.tosspayments.com)
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_...
TOSS_SECRET_KEY=test_sk_...

# 앱 URL (Vercel 배포 후 실제 도메인으로 변경)
NEXT_PUBLIC_APP_URL=http://localhost:3000
